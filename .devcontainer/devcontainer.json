{
  "name": "Nixdesk",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",

  "features": {
    "ghcr.io/devcontainers/features/nix:latest": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },

  "mounts": [
    // "source=${env:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${env:HOME}/.config/git/config,target=/home/vscode/.config/git/config,type=bind,readonly",
    "source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    // "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
  ],

  "remoteEnv": {
    // "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "GitHub.vscode-github-actions"
      ]
    },

    "settings": {
      "terminal.integrated.defaultProfile.linux": "bash",
      "editor.formatOnSave": true,
      "files.trimTrailingWhitespace": true,
      "git.autofetch": true,
      "nix.enableLanguageServer": true,
      "nix.serverPath": "nixd"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh"
}